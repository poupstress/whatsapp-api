# EVOLUTION API - ALTERE AQUI SUAS CONFIGURAÇÕES
EVOLUTION_SERVER_URL=evolution.rdragentes.com.br
EVOLUTION_INSTANCE_ID=poupstress
EVOLUTION_API_KEY=0A2DB22449B7-4B21-9D31-CFDC55CA63E4

# SERVIDOR - CONFIGURAÇÕES PARA DESENVOLVIMENTO
HOST=127.0.0.1
PORT=8000
ROOT_PATH=
DEBUG=true
WORKERS=1
LOG_LEVEL=debug
ENVIRONMENT=development

# DESENVOLVIMENTO
DOMAIN=localhost:8000
SECRET_KEY=chave-desenvolvimento-nao-usar-em-producao
ALLOW_CORS_ALL=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# PERFORMANCE RELAXADA PARA TESTES
HTTP_TIMEOUT=60
DEFAULT_MESSAGE_DELAY=500

# MONITORAMENTO DETALHADO
ENABLE_METRICS=true
HEALTH_CHECK_INTERVAL=30 